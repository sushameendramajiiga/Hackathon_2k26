{
  "name": "StudyPlan",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "subject_name": {
      "type": "string"
    },
    "learner_level": {
      "type": "string"
    },
    "daily_hours": {
      "type": "number"
    },
    "weekly_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hours": {
            "type": "number"
          },
          "completed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "study_tips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "motivational_message": {
      "type": "string"
    },
    "break_interval_minutes": {
      "type": "number"
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "last_studied": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    }
  },
  "required": [
    "subject_id",
    "subject_name"
  ]
}
